	<!-- Breeding Stalls (stall2) - Peek/Enter mechanic: -->
	<scene id="stall2">
		<preParsingEffects><![CDATA[
			#IF(!flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked))
				#IF(flags.hasFlag(FLAG_innoxia_sally_work_promotion1) && game.getCharactersPresent().contains(sally) && !game.isHourBetween(7, 19))
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'STALL2_DOOR_AJAR'))]
				#ELSE
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'STALL2_LOCKED'))]
				#ENDIF
			#ELSE
				[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'STALL2'))]
			#ENDIF
		]]></preParsingEffects>
		<content/>
		<secondsPassed minutes="true"><![CDATA[1]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled><![CDATA[
			[#!flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked) && !(flags.hasFlag(FLAG_innoxia_sally_work_promotion1) && game.getCharactersPresent().contains(sally) && !game.isHourBetween(7, 19))]
		]]></travelDisabled>
		<responses>
			<!-- Peek (first discovery, door ajar, like Lilaya's lab spy option): -->
			<response>
				<availabilityConditional><![CDATA[[#!flags.hasFlag(FLAG_innoxia_sally_discovered_secret) && flags.hasFlag(FLAG_innoxia_sally_work_promotion1) && game.getCharactersPresent().contains(sally) && !game.isHourBetween(7, 19) && !flags.hasFlag(FLAG_innoxia_sally_peeked_today)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Peek]]></responseTitle>
				<responseTooltip><![CDATA[Quietly peer through the gap in the door...]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_peek</nextDialogue>
			</response>
			<!-- Enter directly (first discovery): -->
			<response>
				<availabilityConditional><![CDATA[[#!flags.hasFlag(FLAG_innoxia_sally_discovered_secret) && flags.hasFlag(FLAG_innoxia_sally_work_promotion1) && game.getCharactersPresent().contains(sally) && !game.isHourBetween(7, 19)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Enter]]></responseTitle>
				<responseTooltip><![CDATA[Push the door open and walk in.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_enter_directly</nextDialogue>
			</response>
			<!-- Start breeding work (fleshlight): -->
			<response>
				<availabilityConditional><![CDATA[[#flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked) && flags.getLong(FLAG_innoxia_sally_work_level) == 1 && !game.isHourBetween(7, 19)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Start collections]]></responseTitle>
				<responseTooltip><![CDATA[Start an evening collection session with the fleshlight.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_breeding_work_fleshlight</nextDialogue>
			</response>
			<!-- Start breeding work (by hand with yield options): -->
			<response>
				<availabilityConditional><![CDATA[[#flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked) && flags.getLong(FLAG_innoxia_sally_work_level) >= 2 && !game.isHourBetween(7, 19)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Start collections]]></responseTitle>
				<responseTooltip><![CDATA[Start an evening collection session by hand.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_breeding_work_hand_prep</nextDialogue>
			</response>
			<!-- Too early: -->
			<response>
				<availabilityConditional><![CDATA[[#flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked) && game.isHourBetween(7, 19)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[[style.colourBad(Too early)]]]></responseTitle>
				<responseTooltip><![CDATA[Collections are done in the evening (after 7pm).]]></responseTooltip>
				<nextDialogue>null</nextDialogue>
			</response>
			<!-- Locked, step back: -->
			<response>
				<availabilityConditional><![CDATA[[#!flags.hasFlag(FLAG_innoxia_sally_breeding_unlocked) && !flags.hasFlag(FLAG_innoxia_sally_work_promotion1)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[[pc.Step] back]]></responseTitle>
				<responseTooltip><![CDATA[The door is shut.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_corridor</nextDialogue>
				<effects><![CDATA[
					[#pc.setNearestLocation(WORLD_TYPE_innoxia_fields_sallyStables, PLACE_TYPE_innoxia_fields_sallyStables_corridor)]
				]]></effects>
			</response>
		</responses>
	</scene>


