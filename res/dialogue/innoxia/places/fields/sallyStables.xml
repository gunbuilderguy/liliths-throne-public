			[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'RECEPTION'))]
			#IF(game.getCharactersPresent().contains(sally))
				[#sally.setPlayerKnowsName(true)]
				[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'RECEPTION_SALLY_PRESENT'))]
			#ENDIF
		]]></preParsingEffects>
		<content/>
		<secondsPassed minutes="true"><![CDATA[
			#IF(flags.hasFlag(FLAG_innoxia_sally_work_started) || !game.getCharactersPresent().contains(sally))
				1
			#ELSE
				5
			#ENDIF
		]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled><![CDATA[
			[#!flags.hasFlag(FLAG_innoxia_sally_work_started) && game.getCharactersPresent().contains(sally)]
		]]></travelDisabled>
		<responses>
			<!-- Talk -->
			<response>
				<availabilityConditional><![CDATA[[#game.getCharactersPresent().contains(sally)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Talk]]></responseTitle>
				<responseTooltip><![CDATA[Chat with Sally.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception_talk</nextDialogue>
			</response>
			<!-- Work signup -->
			<response>
				<availabilityConditional><![CDATA[[#game.getCharactersPresent().contains(sally) && !flags.hasFlag(FLAG_innoxia_sally_work_started)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Work]]></responseTitle>
				<responseTooltip><![CDATA[Ask Sally about working at the stables.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception_work</nextDialogue>
			</response>
		</responses>
	</scene>


