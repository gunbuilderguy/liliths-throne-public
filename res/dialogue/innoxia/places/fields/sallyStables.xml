				<index><![CDATA[5]]></index>
				<responseTitle><![CDATA[Back]]></responseTitle>
				<responseTooltip><![CDATA[You've heard enough for now.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception</nextDialogue>
			</response>
		</responses>
