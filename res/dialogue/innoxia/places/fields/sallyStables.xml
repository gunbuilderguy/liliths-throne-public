	<!-- Grooming Stalls (stall1): -->
	<scene id="stall1">
		<content folderPath="txt/places/fields/sallyStables">STALL1</content>
		<secondsPassed minutes="true"><![CDATA[1]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>false</travelDisabled>
		<responses>
			<response>
				<availabilityConditional><![CDATA[[#flags.hasFlag(FLAG_innoxia_sally_work_started)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Start shift]]></responseTitle>
				<responseTooltip><![CDATA[Start a grooming shift (4 hours). You'll earn 400 flames.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_grooming_work</nextDialogue>
			</response>
		</responses>
	</scene>

	<!-- Grooming work: -->
	<scene id="grooming_work">
		<preParsingEffects><![CDATA[
			#IF(flags.getLong(FLAG_innoxia_sally_work_hours) == 0)
				[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'STALL1_WORK_START'))]
			#ELSE
				[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/sallyStables', 'STALL1_WORK_CONTINUE'))]
			#ENDIF
		]]></preParsingEffects>
		<content/>
		<secondsPassed minutes="true"><![CDATA[240]]></secondsPassed>
		<continuesDialogue>true</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<effects><![CDATA[
			[#flags.setLong(FLAG_innoxia_sally_work_hours, flags.getLong(FLAG_innoxia_sally_work_hours) + 4)]
			[#flags.setLong(FLAG_innoxia_sally_total_grooming_hours, flags.getLong(FLAG_innoxia_sally_total_grooming_hours) + 4)]
			[#pc.incrementMoney(400)]
		]]></effects>
		<responses>
			<response>
				<availabilityConditional><![CDATA[[#flags.getLong(FLAG_innoxia_sally_work_hours) < 16]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Keep working]]></responseTitle>
				<responseTooltip><![CDATA[Continue for another 4-hour shift.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_grooming_work</nextDialogue>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Finish]]></responseTitle>
				<responseTooltip><![CDATA[End your shift.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_grooming_work_end</nextDialogue>
			</response>
		</responses>
	</scene>

	<scene id="grooming_work_end">
		<content folderPath="txt/places/fields/sallyStables">STALL1_WORK_END</content>
		<secondsPassed minutes="true"><![CDATA[10]]></secondsPassed>
		<continuesDialogue>true</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<effects><![CDATA[
			[#flags.setLong(FLAG_innoxia_sally_work_hours, 0)]
			#IF(flags.getLong(FLAG_innoxia_sally_total_grooming_hours) >= 20 && !flags.hasFlag(FLAG_innoxia_sally_discovered_secret))
