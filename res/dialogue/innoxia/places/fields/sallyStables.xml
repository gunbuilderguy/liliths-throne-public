				<responseTooltip><![CDATA[Ask about what work there is.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_talk_work</nextDialogue>
			</response>
			<response>
				<availabilityConditional><![CDATA[[#!flags.hasFlag(FLAG_innoxia_sally_talk_stables)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
