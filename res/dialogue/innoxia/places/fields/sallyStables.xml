			#ENDIF
		]]></preParsingEffects>
		<content/>
		<secondsPassed minutes="true"><![CDATA[
			#IF(flags.hasFlag(FLAG_innoxia_sally_work_started) || !game.getCharactersPresent().contains(jed))
				1
			#ELSE
				5
			#ENDIF
		]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled><![CDATA[
			[#!flags.hasFlag(FLAG_innoxia_sally_work_started)]
		]]></travelDisabled>
		<responses>
			<!-- Talk -->
			<response>
				<availabilityConditional><![CDATA[[#game.getCharactersPresent().contains(jed)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Talk]]></responseTitle>
				<responseTooltip><![CDATA[Chat with Jed for a bit.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception_talk</nextDialogue>
			</response>
			<!-- Work signup -->
			<response>
				<availabilityConditional><![CDATA[[#game.getCharactersPresent().contains(jed) && !flags.hasFlag(FLAG_innoxia_sally_work_started)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Work]]></responseTitle>
				<responseTooltip><![CDATA[Ask Jed about working at the stables.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception_work</nextDialogue>
			</response>
			<!-- Promotion (when eligible) -->
			<response>
				<availabilityConditional><![CDATA[[#game.getCharactersPresent().contains(jed) && flags.hasFlag(FLAG_innoxia_sally_work_started) && flags.hasFlag(FLAG_innoxia_sally_work_promotion1)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[3]]></index>
				<responseTitle><![CDATA[Promotion]]></responseTitle>
				<responseTooltip><![CDATA[Jed mentioned that Sally wanted to speak with you about a promotion.]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_reception_promotion</nextDialogue>
			</response>
		</responses>
	</scene>


