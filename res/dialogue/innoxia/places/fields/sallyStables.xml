				<responseTitle><![CDATA[Sally's Stables]]></responseTitle>
				<responseTooltip><![CDATA[Head over to Sally's Stables and [pc.step] inside...]]></responseTooltip>
				<nextDialogue>innoxia_places_fields_sallyStables_exit</nextDialogue>
